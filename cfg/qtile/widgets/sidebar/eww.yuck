;; Top bar for Qtile (eww), launched by ~/.config/qtile/scripts/sidebar_setup

;; ---------- data ----------
;; EWW_RAM / EWW_CPU / EWW_DISK / EWW_TIME are built in (no processes spawned)
(deflisten workspaces :initial "[]" "~/.config/qtile/widgets/sidebar/scripts/workspaces")
(deflisten volume :initial "{\"vol\":0,\"muted\":false}" "~/.config/qtile/widgets/sidebar/scripts/volume")
(defpoll wifi :interval "10s" :initial "{\"signal\":0,\"ssid\":\"\",\"icon\":\"\",\"on\":false}" "~/.config/qtile/widgets/sidebar/scripts/wifi")
(defpoll brightness :interval "5s" :initial "0" "brightnessctl -m | cut -d, -f4 | tr -d %")
(defvar show_date false)
(defvar eye_on false)
(defvar eye_temp 3500)
(defpoll bt :interval "5s" :initial "{\"on\":false,\"connected\":0,\"icon\":\"\",\"name\":\"\",\"battery\":-1}" "~/.config/qtile/widgets/sidebar/scripts/bluetooth status")
(defpoll bat :interval "10s" :initial "{\"present\":false,\"cap\":0,\"icon\":\"\",\"status\":\"\",\"class\":\"normal\",\"ac\":false,\"power_w\":0,\"volt_v\":0,\"energy_now_wh\":0,\"energy_full_wh\":0,\"energy_design_wh\":0,\"health\":0,\"cycles\":0,\"tech\":\"\",\"model\":\"\",\"mfr\":\"\",\"time\":\"\",\"time_label\":\"\"}" "~/.config/qtile/widgets/sidebar/scripts/battery")
(defvar settings_open false)
(defvar notif_popups "[]")
(defvar notif_history "[]")
(defvar notif_count 0)
(defvar notif_dnd false)
(defvar audio_sinks "[]")
(defvar audio_sources "[]")
(defvar mic_muted false)
(defpoll sysinfo :interval "3s" :run-while settings_open
  :initial "{\"cpu_t\":0,\"gpu_t\":0,\"nvme_t\":0,\"fan\":0,\"mhz\":0,\"ip\":\"\",\"down\":0,\"up\":0,\"uptime\":\"\",\"kernel\":\"\",\"host\":\"\",\"top\":\"\"}"
  "~/.config/qtile/widgets/sidebar/scripts/sysinfo")
(defvar bt_devices "[]")
(defvar bt_scanning false)
(defvar bt_busy "")

;; ---------- widgets ----------
(defwidget workspaces_w []
  (eventbox :onscroll "if [ {} = up ]; then qtile cmd-obj -o screen -f prev_group; else qtile cmd-obj -o screen -f next_group; fi"
    (box :class "module workspaces" :orientation "h" :space-evenly false :spacing 0
      (for ws in workspaces
        (button :class "ws ${ws.state}"
                :tooltip "Workspace ${ws.id}"
                :onclick "xdotool set_desktop ${ws.index}"
          (box :class "pill" :halign "center" :valign "center"))))))

(defwidget clock_w []
  (eventbox :cursor "pointer"
            :onclick "eww -c ~/.config/qtile/widgets/sidebar update show_date=${!show_date}"
    (box :class "module clock" :space-evenly false :spacing 6
         :tooltip "${formattime(EWW_TIME, '%A, %d %B %Y')}"
      (label :class "date" :visible show_date :text "${formattime(EWW_TIME, '%a %d %b')}")
      (label :class "hour" :text "${formattime(EWW_TIME, '%H')}")
      (label :class "sep" :text ":")
      (label :class "min" :text "${formattime(EWW_TIME, '%M')}"))))

;; icon with the value to the right
(defwidget stat [icon value text class tip onclick onrightclick onscroll]
  (eventbox :onclick onclick :onrightclick onrightclick :onscroll onscroll :cursor "pointer"
    (box :class "stat ${class}" :orientation "h" :space-evenly false :spacing 5 :tooltip tip
      (label :class "icon" :text icon)
      (label :class "val" :text text))))

(defwidget system_w []
  (box :class "module stats" :space-evenly false :spacing 12
    (stat :class "ram" :icon ""
          :value {EWW_RAM.used_mem_perc} :text "${round(EWW_RAM.used_mem_perc, 0)}%"
          :tip "RAM ${round(EWW_RAM.used_mem / 1000000000, 1)} / ${round(EWW_RAM.total_mem / 1000000000, 1)} GB"
          :onclick "~/.config/qtile/widgets/resources/scripts/toggle &" :onrightclick "" :onscroll "")
    (stat :class "cpu" :icon "󰍛"
          :value {EWW_CPU.avg} :text "${round(EWW_CPU.avg, 0)}%"
          :tip "CPU ${round(EWW_CPU.avg, 1)}%"
          :onclick "~/.config/qtile/widgets/resources/scripts/toggle &" :onrightclick "" :onscroll "")
    (stat :class "disk" :icon "󰋊"
          :value {EWW_DISK["/"].used_perc} :text "${round(EWW_DISK["/"].used_perc, 0)}%"
          :tip "Disk / ${round(EWW_DISK["/"].used / 1000000000, 0)} / ${round(EWW_DISK["/"].total / 1000000000, 0)} GB"
          :onclick "" :onrightclick "" :onscroll "")))

(defwidget controls_w []
  (box :class "module stats" :space-evenly false :spacing 12
    (stat :class "vol ${volume.muted ? 'muted' : ''}" :icon {volume.muted ? "" : ""}
          :value {volume.vol} :text {volume.muted ? "off" : "${volume.vol}%"}
          :tip "Volume ${volume.vol}% (click mute, scroll change, right-click mixer)"
          :onclick "pactl set-sink-mute @DEFAULT_SINK@ toggle"
          :onrightclick "pavucontrol &"
          :onscroll "if [ {} = up ]; then wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+; else wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-; fi")
    (stat :class "bri" :icon "󰃠"
          :value brightness :text "${brightness}%"
          :tip "Brightness ${brightness}% (scroll to change)"
          :onclick "" :onrightclick ""
          :onscroll "if [ {} = up ]; then brightnessctl -q set 5%+; else brightnessctl -q set 5%-; fi; eww -c ~/.config/qtile/widgets/sidebar update brightness=$(brightnessctl -m | cut -d, -f4 | tr -d %)")
    (stat :class "wifi ${wifi.on ? '' : 'off'}" :icon {wifi.icon}
          :value {wifi.signal} :text {wifi.on ? "${wifi.signal}%" : "off"}
          :tip {wifi.on ? "${wifi.ssid}" : "Offline"}
          :onclick "~/.config/qtile/scripts/network_menu &" :onrightclick "" :onscroll "")))

;; ---------- quick settings (far right) ----------
(defwidget quick_w []
  (box :class "module quick" :space-evenly false :spacing 10
    (eventbox :cursor "pointer"
              :onclick "~/.config/qtile/widgets/sidebar/scripts/popup toggle bluetooth &"
              :onrightclick "~/.config/qtile/widgets/sidebar/scripts/bluetooth power &"
      (box :class "stat bt ${bt.on ? '' : 'off'} ${bt.connected > 0 ? 'connected' : ''}"
           :tooltip {bt.on ? (bt.connected > 0 ? "Connected: ${bt.name}${bt.battery >= 0 ? ' · ' + bt.battery + '%' : ''}" : "Bluetooth on") : "Bluetooth off"}
        (label :class "icon" :text {bt.icon})))))

;; ---------- battery ----------
(defwidget battery_w []
  (eventbox :cursor "pointer" :onclick "~/.config/qtile/widgets/sidebar/scripts/popup toggle battery &"
    (box :class "module battery ${bat.class}" :space-evenly false :spacing 6
         :tooltip "${bat.status} - ${bat.time_label}: ${bat.time}"
      (label :class "icon" :text {bat.icon})
      (label :class "val" :text "${bat.cap}%"))))

(defwidget brow [k v]
  (box :class "brow" :space-evenly false
    (label :class "bk" :halign "start" :hexpand true :text k)
    (label :class "bv" :halign "end" :text v)))

(defwidget battery_menu_w []
  (box :class "batmenu ${bat.class}" :orientation "v" :space-evenly false :spacing 8
    (box :space-evenly false :spacing 8
      (label :class "bttitle" :halign "start" :hexpand true :text "${bat.icon}  Battery"))
    (box :class "batbig" :orientation "v" :space-evenly false :spacing 4
      (label :class "batpct" :text "${bat.cap}%")
      (label :class "batstate" :text "${bat.status}${bat.ac ? ' · AC connected' : ' · on battery'}")
      (progress :class "batbar" :value {bat.cap} :orientation "h" :flipped false))
    (box :class "batinfo" :orientation "v" :space-evenly false :spacing 3
      (brow :k {bat.time_label} :v {bat.time})
      (brow :k "Power draw" :v "${bat.power_w} W")
      (brow :k "Voltage" :v "${bat.volt_v} V")
      (brow :k "Energy" :v "${bat.energy_now_wh} / ${bat.energy_full_wh} Wh")
      (brow :k "Design capacity" :v "${bat.energy_design_wh} Wh")
      (brow :k "Health" :v "${bat.health}%")
      (brow :k "Cycles" :v "${bat.cycles}")
      (brow :k "Technology" :v {bat.tech})
      (brow :k "Model" :v "${bat.mfr} ${bat.model}"))))

;; ---------- bluetooth menu ----------
(defwidget bt_device [d]
  (box :class "dev ${d.connected ? 'connected' : ''}" :space-evenly false :spacing 6
    (eventbox :hexpand true :cursor "pointer"
              :onclick "~/.config/qtile/widgets/sidebar/scripts/bluetooth toggle ${d.mac} &"
      (box :space-evenly false :spacing 10
        (label :class "dicon" :text {d.icon})
        (box :orientation "v" :space-evenly false :halign "start" :valign "center"
          (label :class "dname" :halign "start" :limit-width 26 :text {d.name})
          (label :class "dsub" :halign "start"
                 :text {bt_busy == d.mac ? "working..." : (d.connected ? "Connected" : (d.paired ? "Paired" : "Available"))}))))
    (label :class "dbat ${d.battery <= 15 ? 'critical' : (d.battery <= 30 ? 'low' : '')}"
           :visible {d.connected && d.battery >= 0}
           :text "${d.battery <= 15 ? '󰁺' : (d.battery <= 30 ? '󰁻' : (d.battery <= 50 ? '󰁾' : (d.battery <= 80 ? '󰂀' : '󰁹')))} ${d.battery}%")
    (eventbox :cursor "pointer" :visible {d.paired}
              :tooltip "Forget device"
              :onclick "~/.config/qtile/widgets/sidebar/scripts/bluetooth forget ${d.mac} &"
      (label :class "forget" :text "󰆴"))))

(defwidget bt_menu_w []
  (box :class "btmenu" :orientation "v" :space-evenly false :spacing 8
    (box :class "bthead" :space-evenly false :spacing 8
      (label :class "bttitle" :halign "start" :hexpand true :text "󰂯  Bluetooth")
      (eventbox :cursor "pointer" :onclick "~/.config/qtile/widgets/sidebar/scripts/bluetooth power &"
        (label :class "btswitch ${bt.on ? 'on' : ''}" :text {bt.on ? "ON" : "OFF"})))
    (eventbox :cursor "pointer" :visible {bt.on}
              :onclick {bt_scanning ? "" : "~/.config/qtile/widgets/sidebar/scripts/bluetooth scan &"}
      (label :class "btscan ${bt_scanning ? 'busy' : ''}" :text {bt_scanning ? "󰑐  Scanning..." : "󰑐  Scan for devices"}))
    (scroll :vscroll true :hscroll false :height 260 :visible {bt.on}
      (box :orientation "v" :space-evenly false :spacing 4
        (label :class "btempty" :visible {arraylength(bt_devices) == 0}
               :text "No devices. Press Scan.")
        (for d in bt_devices (bt_device :d d))))
    (label :class "btempty" :visible {!bt.on} :text "Bluetooth is off")))

;; ---------- settings overlay ----------
(defwidget settings_w []
  (eventbox :cursor "pointer" :tooltip "Settings"
            :onclick "~/.config/qtile/widgets/sidebar/scripts/popup toggle settings &"
    (box :class "module gear"
      (label :class "icon" :text "󰒓"))))

(defwidget scard [title icon]
  (box :class "scard" :orientation "v" :space-evenly false :spacing 8
    (box :space-evenly false :spacing 8
      (label :class "sicon" :text icon)
      (label :class "stitle" :halign "start" :hexpand true :text title))
    (children)))

(defwidget stoggle [on onclick]
  (eventbox :cursor "pointer" :onclick onclick
    (label :class "btswitch ${on ? 'on' : ''}" :text {on ? "ON" : "OFF"})))

(defwidget sbutton [text onclick]
  (eventbox :cursor "pointer" :onclick onclick
    (label :class "btscan" :text text)))

;; big launcher tile: glyph over label
(defwidget stile [icon text onclick]
  (eventbox :cursor "pointer" :onclick onclick
    (box :class "stile" :orientation "v" :space-evenly false :spacing 4
      (label :class "stileicon" :text icon)
      (label :class "stiletext" :text text))))

(defwidget sdevice [d]
  (eventbox :cursor "pointer" :onclick "~/.config/qtile/widgets/sidebar/scripts/audio set ${d.id} &"
    (box :class "dev ${d.default ? 'connected' : ''}" :space-evenly false
      (label :class "dname" :halign "start" :limit-width 34 :text {d.name}))))

(defwidget settings_menu_w []
  (eventbox :onclick "~/.config/qtile/widgets/sidebar/scripts/popup close &"
    (box :class "settings_overlay" :halign "fill" :valign "fill" :hexpand true :vexpand true
      (eventbox :onclick "" :halign "center" :valign "center"
        (box :orientation "v" :space-evenly false :spacing 14
          (box :class "launcher" :space-evenly true :spacing 12
            (stile :icon "󰝚" :text "Music" :onclick "~/.config/qtile/widgets/sidebar/scripts/launch music &")
            (stile :icon "󰈹" :text "Browser" :onclick "~/.config/qtile/widgets/sidebar/scripts/launch browser &")
            (stile :icon "" :text "Terminal" :onclick "~/.config/qtile/widgets/sidebar/scripts/launch terminal &")
            (stile :icon "󰉋" :text "Files" :onclick "~/.config/qtile/widgets/sidebar/scripts/launch files &"))
          (box :space-evenly false :spacing 14
            (box :orientation "v" :space-evenly false :spacing 14
              (scard :title "Wi-Fi" :icon {wifi.icon}
                (box :orientation "v" :space-evenly false :spacing 6
                  (box :space-evenly false
                    (label :class "bk" :hexpand true :halign "start" :text {wifi.on ? wifi.ssid : "Not connected"})
                    (stoggle :on {wifi.on} :onclick "nmcli radio wifi ${wifi.on ? 'off' : 'on'} &"))
                  (brow :k "Signal" :v "${wifi.signal}%")
                  (brow :k "IP" :v {sysinfo.ip == "" ? "-" : sysinfo.ip})
                  (brow :k "Download" :v "${sysinfo.down} KB/s")
                  (brow :k "Upload" :v "${sysinfo.up} KB/s")
                  (sbutton :text "󰖩  Networks" :onclick "~/.config/qtile/scripts/network_menu &")))
              (scard :title "Bluetooth" :icon {bt.icon}
                (box :orientation "v" :space-evenly false :spacing 6
                  (box :space-evenly false
                    (label :class "bk" :hexpand true :halign "start"
                           :text {bt.on ? (bt.connected > 0 ? bt.name : "No device connected") : "Off"})
                    (stoggle :on {bt.on} :onclick "~/.config/qtile/widgets/sidebar/scripts/bluetooth power &"))
                  (brow :k "Connected" :v "${bt.connected}")
                  (brow :k "Device battery" :v {bt.battery >= 0 ? "${bt.battery}%" : "-"})
                  (sbutton :text "󰑐  Scan / manage" :onclick "~/.config/qtile/widgets/sidebar/scripts/popup toggle bluetooth &"))))
            (box :orientation "v" :space-evenly false :spacing 14
              (scard :title "Audio" :icon {volume.muted ? "" : ""}
                (box :orientation "v" :space-evenly false :spacing 6
                  (box :space-evenly false :spacing 8
                    (eventbox :cursor "pointer" :onclick "pactl set-sink-mute @DEFAULT_SINK@ toggle"
                      (label :class "sicon ${volume.muted ? 'muted' : ''}" :text {volume.muted ? "" : ""}))
                    (scale :class "sscale" :hexpand true :min 0 :max 101 :value {volume.vol}
                           :onchange "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ {}%")
                    (label :class "bv" :text "${volume.vol}%"))
                  (label :class "bk" :halign "start" :text "Output")
                  (for d in audio_sinks (sdevice :d d))
                  (box :space-evenly false :spacing 8
                    (label :class "bk" :hexpand true :halign "start" :text "Input")
                    (stoggle :on {!mic_muted} :onclick "~/.config/qtile/widgets/sidebar/scripts/audio mic-toggle; eww -c ~/.config/qtile/widgets/sidebar update mic_muted=$(~/.config/qtile/widgets/sidebar/scripts/audio mic) &"))
                  (for d in audio_sources (sdevice :d d))
                  (sbutton :text "󰕾  Mixer" :onclick "pavucontrol &")))
              (scard :title "Brightness" :icon "󰃠"
                (box :space-evenly false :spacing 8
                  (scale :class "sscale" :hexpand true :min 1 :max 101 :value brightness
                         :onchange "brightnessctl -q set {}%")
                  (label :class "bv" :text "${brightness}%")))
              (scard :title "Eye care" :icon "\U000F0208"
                (box :orientation "v" :space-evenly false :spacing 6
                  (box :space-evenly false
                    (label :class "bk" :hexpand true :halign "start" :text "Night filter")
                    (stoggle :on {eye_on} :onclick "~/.config/qtile/scripts/qtile_eyecare; eww -c ~/.config/qtile/widgets/sidebar update eye_on=$(~/.config/qtile/scripts/qtile_eyecare --status) eye_temp=$(~/.config/qtile/scripts/qtile_eyecare --get) &"))
                  (box :space-evenly false :spacing 8
                    (scale :class "sscale" :hexpand true :min 1000 :max 6500 :value {eye_temp}
                           :onchange "~/.config/qtile/scripts/qtile_eyecare --temp {}; eww -c ~/.config/qtile/widgets/sidebar update eye_on=true eye_temp={}")
                    (label :class "bv" :text "${round(eye_temp, 0)}K"))))))
          (scard :title "System" :icon "󰌢"
            (box :orientation "h" :space-evenly false :spacing 24
              (box :orientation "v" :space-evenly false :spacing 3
                (brow :k "Host" :v {sysinfo.host})
                (brow :k "Kernel" :v {sysinfo.kernel})
                (brow :k "Uptime" :v {sysinfo.uptime})
                (brow :k "CPU" :v "${round(EWW_CPU.avg, 0)}%  ·  ${sysinfo.mhz} MHz")
                (brow :k "RAM" :v "${round(EWW_RAM.used_mem_perc, 0)}%  ·  ${round(EWW_RAM.used_mem / 1000000000, 1)} / ${round(EWW_RAM.total_mem / 1000000000, 1)} GB")
                (brow :k "Disk /" :v "${round(EWW_DISK["/"].used_perc, 0)}%"))
              (box :orientation "v" :space-evenly false :spacing 3
                (brow :k "CPU temp" :v "${sysinfo.cpu_t}°C")
                (brow :k "GPU temp" :v "${sysinfo.gpu_t}°C")
                (brow :k "NVMe temp" :v "${sysinfo.nvme_t}°C")
                (brow :k "Fan" :v {sysinfo.fan > 0 ? "${sysinfo.fan} RPM" : "-"})
                (brow :k "Battery" :v "${bat.cap}%  ·  ${bat.status}")
                (brow :k "Top" :v {sysinfo.top})))))))))

;; ---------- notifications ----------
(defwidget bell_w []
  (eventbox :cursor "pointer" :tooltip "Notifications"
            :onclick "~/.config/qtile/widgets/sidebar/scripts/popup toggle notifications &"
            :onrightclick "~/.config/qtile/widgets/sidebar/scripts/notify_ctl dnd &"
    (box :class "module bell ${notif_dnd ? 'dnd' : ''} ${notif_count > 0 ? 'unread' : ''}" :space-evenly false :spacing 5
      (label :class "icon" :text {notif_dnd ? "󰂛" : (notif_count > 0 ? "󰂚" : "󰂜")})
      (label :class "val ncount" :visible {notif_count > 0} :text "${notif_count}"))))

;; one card for both the popups and the center; `onclose` runs when it is clicked / dismissed
(defwidget ncard [n onclick onclose]
  (eventbox :cursor "pointer" :onclick onclick
    (box :class "ncard ${n.urgency} ${n.kind}" :orientation "v" :space-evenly false :spacing 6
      (box :space-evenly false :spacing 10
        (box :class "nicon-wrap" :valign "start"
          (image :class "nimg" :visible {n.has_icon} :path {n.icon} :image-width 32 :image-height 32)
          (label :class "nglyph" :visible {!n.has_icon} :text {n.glyph}))
        (box :orientation "v" :space-evenly false :spacing 2 :hexpand true :valign "center"
          (box :space-evenly false :spacing 6
            (label :class "napp" :halign "start" :hexpand true :limit-width 24 :text {n.app})
            (label :class "ntime" :halign "end" :text {n.time}))
          (label :class "nsum" :halign "start" :xalign 0 :limit-width 38 :text {n.summary})
          (label :class "nbody" :halign "start" :xalign 0
                 :visible {n.body != "" && n.kind != "progress"} :text {n.body}))
        (eventbox :cursor "pointer" :valign "start" :visible {onclose != ""} :onclick onclose
          (label :class "nclose" :text "󰅖")))
      (box :class "nprog" :visible {n.kind == "progress"} :space-evenly false :spacing 8
        (progress :class "nbar" :hexpand true :value {n.progress} :orientation "h" :flipped false)
        (label :class "nval" :text "${n.progress}%")))))

(defwidget notif_popups_w []
  (box :class "npopups" :orientation "v" :space-evenly false :spacing 8
    (for n in notif_popups
      (ncard :n n :onclick "~/.config/qtile/widgets/sidebar/scripts/notify_ctl dismiss_popup ${n.uid} &" :onclose ""))))

(defwidget notif_menu_w []
  (box :class "nmenu" :orientation "v" :space-evenly false :spacing 8
    (box :space-evenly false :spacing 8
      (label :class "bttitle" :halign "start" :hexpand true :text "󰂚  Notifications")
      (eventbox :cursor "pointer" :tooltip "Do not disturb" :onclick "~/.config/qtile/widgets/sidebar/scripts/notify_ctl dnd &"
        (label :class "btswitch ${notif_dnd ? 'on' : ''}" :text {notif_dnd ? "DND ON" : "DND OFF"}))
      (eventbox :cursor "pointer" :visible {notif_count > 0} :onclick "~/.config/qtile/widgets/sidebar/scripts/notify_ctl clear &"
        (label :class "btswitch" :text "Clear")))
    (scroll :vscroll true :hscroll false :height 380
      (box :orientation "v" :space-evenly false :spacing 6
        (label :class "btempty" :visible {notif_count == 0} :text "No notifications")
        (for n in notif_history
          (ncard :n n :onclick "" :onclose "~/.config/qtile/widgets/sidebar/scripts/notify_ctl dismiss ${n.uid} &"))))))

(defwidget bar_w []
  (centerbox :class "bar" :orientation "h"
    (box :halign "start" :space-evenly false :spacing 6 (workspaces_w) (system_w))
    (box :halign "center" (clock_w))
    (box :halign "end" :space-evenly false :spacing 6 (controls_w) (quick_w) (settings_w) (battery_w))))

;; ---------- window ----------
(defwindow sidebar
  :monitor 0
  :geometry (geometry :x "0px" :y "0px" :width "100%" :height "32px" :anchor "top center")
  :windowtype "dock"
  :stacking "fg"
  :wm-ignore false
  :reserve (struts :side "top" :distance "32px")
  (bar_w))

(defwindow bluetooth_menu
  :monitor 0
  :geometry (geometry :x "8px" :y "38px" :width "340px" :anchor "top right")
  :windowtype "dock"
  :stacking "fg"
  :wm-ignore false
  (bt_menu_w))

(defwindow battery_menu
  :monitor 0
  :geometry (geometry :x "8px" :y "38px" :width "320px" :anchor "top right")
  :windowtype "dock"
  :stacking "fg"
  :wm-ignore false
  (battery_menu_w))

(defwindow notifications_menu
  :monitor 0
  :geometry (geometry :x "8px" :y "38px" :width "380px" :anchor "top right")
  :windowtype "dock"
  :stacking "fg"
  :wm-ignore false
  (notif_menu_w))

;; popups are click-through-free cards drawn top right, below the bar
(defwindow notif_popups
  :monitor 0
  :geometry (geometry :x "8px" :y "40px" :width "360px" :anchor "top right")
  :windowtype "dock"
  :stacking "overlay"
  :wm-ignore false
  (notif_popups_w))

(defwindow settings_menu
  :monitor 0
  :geometry (geometry :x "0px" :y "32px" :width "100%" :height "100%" :anchor "top left")
  :windowtype "dock"
  :stacking "fg"
  :wm-ignore false
  (settings_menu_w))

;; transparent layer behind the popups: any click closes them (starts below the bar)
(defwindow popup_catcher
  :monitor 0
  :geometry (geometry :x "0px" :y "32px" :width "100%" :height "100%" :anchor "top left")
  :windowtype "dock"
  :stacking "fg"
  :wm-ignore false
  (eventbox :onclick "~/.config/qtile/widgets/sidebar/scripts/popup close &"
    (box :class "catcher")))
