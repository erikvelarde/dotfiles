#!/usr/bin/env bash
# Free RAM/CPU by killing apps listed in apps.conf (SIGTERM, then SIGKILL).
#   clean ram    kill apps using >= RAM_MIN_MB, plus idle Java, then drop page cache
#   clean cpu    kill apps using >= CPU_MIN % CPU, plus idle Java
#   clean all    kill every listed app
#   clean <name> kill one app (label from the list, e.g. Firefox)
dir="$HOME/.config/qtile/widgets/resources"
RAM_MIN_MB="${RAM_MIN_MB:-300}"
CPU_MIN="${CPU_MIN:-10}"

protect_re=$(sed -n 's/^#PROTECT=//p' "$dir/apps.conf")

# pids that must survive: this script's ancestors and the ancestors of PROTECT matches
protected=" "
for p in $$ $([[ -n $protect_re ]] && pgrep -x "$protect_re"); do
  while [[ -n $p && $p -gt 1 ]]; do
    protected+="$p "
    p=$(ps -o ppid= -p "$p" | tr -d ' ')
  done
done

total_rss() { "$dir/scripts/procs" scan | awk -F'\t' '{ s += $4 } END { print s + 0 }'; }

before=$(total_rss)
case "$1" in
  ram) sel='($1 in mem) && mem[$1] >= ram || ($1 == "Java" && cpu[$1] < 1)' ;;
  cpu) sel='($1 in cpu) && cpu[$1] >= cpuMin || ($1 == "Java" && cpu[$1] < 1)' ;;
  all) sel='1' ;;
  "") echo "usage: $0 ram|cpu|all|<name>" >&2; exit 1 ;;
  *)   sel='$1 == name' ;;
esac

pids=$("$dir/scripts/procs" scan | awk -F'\t' -v name="$1" -v ram=$((RAM_MIN_MB * 1024)) -v cpuMin="$CPU_MIN" '
  { rows[NR] = $0; cpu[$1] += $3; mem[$1] += $4 }
  END { for (i = 1; i <= NR; i++) { split(rows[i], f, "\t"); $1 = f[1]
          if ('"$sel"') print f[2] } }')

kill_list=(); containers=(); failed=0
for p in $pids; do
  [[ $protected == *" $p "* ]] && continue
  if [[ $(stat -c %u "/proc/$p" 2>/dev/null) == "$UID" ]]; then
    kill_list+=("$p")
  else
    # not ours (e.g. Java inside a docker container): stop the container instead
    c=$(grep -o 'docker-[0-9a-f]\{64\}' "/proc/$p/cgroup" 2>/dev/null | head -n1)
    c=${c#docker-}
    [[ -n $c && " ${containers[*]} " != *" ${c:0:12} "* ]] && containers+=("${c:0:12}") || ((failed++))
  fi
done

if ((${#kill_list[@]})); then
  kill -TERM "${kill_list[@]}" 2>/dev/null
  sleep 2
  kill -KILL "${kill_list[@]}" 2>/dev/null
fi
((${#containers[@]})) && docker stop -t 3 "${containers[@]}" >/dev/null 2>&1

if [[ $1 == ram ]]; then
  sync
  sudo -n /usr/bin/tee /proc/sys/vm/drop_caches <<<3 >/dev/null 2>&1
fi


after=$(total_rss)
msg="Killed ${#kill_list[@]} process(es)"
((${#containers[@]})) && msg+=", stopped ${#containers[@]} container(s)"
((failed)) && msg+=", $failed could not be killed"
notify-send -t 2500 "Resources" "$msg, freed ~$(((before - after) / 1024)) MB"
