#!/usr/bin/env bash
# Resources widget data. Only apps listed in apps.conf are reported.
#   procs        -> JSON [{name,count,cpu,mem,idle}] sorted by memory (MB)
#   procs scan   -> TSV rows: label pid cpu rss_kb
conf="$HOME/.config/qtile/widgets/resources/apps.conf"

scan() {
  ps -eo pid=,pcpu=,rss=,args= | awk -v conf="$conf" '
    BEGIN {
      while ((getline l < conf) > 0) {
        if (l ~ /^[[:space:]]*(#|$)/) continue
        i = index(l, "|"); n++
        lab[n] = substr(l, 1, i - 1); re[n] = tolower(substr(l, i + 1))
      }
    }
    { exe = tolower($4)
      for (k = 1; k <= n; k++) if (exe ~ re[k]) { print lab[k] "\t" $1 "\t" $2 "\t" $3; break } }'
}

case "$1" in
  scan) scan ;;
  *)
    scan | awk -F'\t' '{ c[$1]++; cpu[$1] += $3; mem[$1] += $4 }
      END { for (a in c) printf "%s\t%d\t%.1f\t%d\n", a, c[a], cpu[a], mem[a] / 1024 }' |
      jq -R -s -c '[split("\n")[] | select(length > 0) | split("\t")
        | {name: .[0], count: (.[1] | tonumber), cpu: (.[2] | tonumber), mem: (.[3] | tonumber)}
        | .idle = (.cpu < 1)] | sort_by(-.mem)'
    ;;
esac
